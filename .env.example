# Copy to .env and fill in locally. The .env file is ignored by git.
# The run and fetch commands read it by default (--env-file changes the path),
# and never override a variable the surrounding process already set.
AUCTION_LENS_SMTP_HOST=
AUCTION_LENS_SMTP_USERNAME=
AUCTION_LENS_SMTP_PASSWORD=
AUCTION_LENS_EMAIL_FROM=
AUCTION_LENS_EMAIL_TO=
AUCTION_LENS_HTTP_USER_AGENT=
